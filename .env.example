# All values are optional; defaults shown.

KAFKA_BROKERS=localhost:9092

API_ADDR=:8000
# One address per pretend destination host; each is a distinct host to the delivery worker.
RECEIVER_ADDRS=:8080,:8081,:8082
METRICS_ADDR=:9100

EVENTS_TOPIC=events
RETRIES_TOPIC=retries
DLQ_TOPIC=dead-letter
DELIVERY_GROUP=delivery-worker
RETRY_GROUP=retry-worker

BATCH_CAPACITY=50
BATCH_FILL_TIMEOUT=200ms
MAX_CONCURRENCY=10
MAX_CONCURRENCY_PER_HOST=5

# How long a producer waits for a batch to fill before sending. kafka-go defaults to 1s, which
# caps a synchronous publish at one per second per caller.
PRODUCER_BATCH_TIMEOUT=10ms

RETRY_COUNT_LIMIT=5
BASE_BACKOFF=1s

# Oldest an event may get, measured from its createdAt, before it is dead-lettered regardless
# of how many times it was attempted. Bounds how long a dead host can hold events in `retries`,
# since breaker rejections deliberately do not consume retry budget. 0 disables the limit.
#
# 1h because the normal failure path exhausts its backoff ladder in 30s, so this is ~120x
# headroom for a transient outage or a deploy. Past that, the destination is having a real
# incident, and holding events longer only delays the DLQ alarm that would surface it.
MAX_EVENT_AGE=1h

BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN=45s

DELIVERY_TIMEOUT=10s

LOG_LEVEL=info
